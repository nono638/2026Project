__pycache__/
*.pyc
.venv/
.env

# Runtime configuration — managed by dayrun/nightrun launchers, not source-controlled
.claude/active_mode.md
.claude/settings.json
.claude/settings.local.json
.claude/hooks/

# Auto-updated model fallback (written after successful sessions)
_claude_sandbox_setup/.model_defaults

# RunPod pod tracking (survives process death for cleanup on next run)
.runpod_pod_id

# Scheduled-task runtime lock (managed by .claude/loop runner)
.claude/scheduled_tasks.lock

# Runtime logs and artifacts
DaytimeNighttimeHandOff/audit.jsonl
DaytimeNighttimeHandOff/nighttime.log
DaytimeNighttimeHandOff/*.bak
pip_output.txt

# Generated gallery HTML — the generator script is the source of truth
site/*.html
